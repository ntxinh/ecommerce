DATABASE_URL="file:./data/marketflow.db"
APP_ENV="development"
SESSION_COOKIE_NAME="marketflow_session"
API_DOCS_ENABLED="false"
INTERNAL_CRON_TOKEN="dev-cron-token"
# Optional — read from process.env directly, not schema-validated:
# LOG_LEVEL="info"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Stripe card payments — optional; absent keys hide the method and 404 the webhook.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Finix hosted checkout — optional; absent keys hide the method and 404 the webhook.
# FINIX_USERNAME="US..."
# FINIX_PASSWORD="..."
# FINIX_MERCHANT_ID="MU..."
# FINIX_APPLICATION_ID="AP..."
# FINIX_BASE_URL="https://finix.sandbox-payments-api.com"
# FINIX_WEBHOOK_SECRET="..."        # webhook's secret_signing_key (POST /webhooks)
# FINIX_LOGO_URL="https://..."      # hosted-form branding overrides
# FINIX_ICON_URL="https://..."
